<?xml version="1.0" encoding="utf-8"?>
<!--
  Capabilities are deliberately limited to what the UAT flows need.

  android:packageNames  - the service only receives events from, and can only
                          inspect, the allowlisted UAT packages (Ashika and
                          Tradion, see TargetApp.kt) plus the system
                          screens needed to reset it before a run: Settings
                          (App info > Storage > Clear storage; MIUI puts App
                          info in com.miui.securitycenter) and the permission
                          controller (the notification prompt that returns
                          after every reset) and System UI, which draws the
                          screen-recording prompt (RecordingPromptAccepter.kt
                          reads it only for a few seconds after the operator
                          presses Start, and touches only the dialog that names
                          this tool). It is blind to every other app,
                          including the keyboard and the launcher. Keep in step
                          with SETTINGS_PACKAGES / PERMISSION_CONTROLLER_PACKAGES
                          in AutomationConfig.kt.
  flagReportViewIds     - required to read `viewIdResourceName`, which is where
                          Flutter publishes `Semantics(identifier:)`. Without
                          this flag every identifier lookup returns null.
  flagIncludeNotImportantViews
                        - Flutter marks container-only semantics nodes (the
                          `*_screen` markers, which carry no label of their own)
                          as not-important-for-accessibility. Without this flag
                          the platform filters them out of the tree handed to
                          the service and screen detection fails.
  flagRetrieveInteractiveWindows
                        - lets the service list every window on screen. The
                          notification permission prompt is its own window on
                          top of the target app, but the system keeps reporting
                          the app as the *active* window, so without this the
                          prompt is never seen and cannot be answered.
  canPerformGestures    - only used as a fallback tap at the resolved node's own
                          bounds when a node advertises no ACTION_CLICK.
  canTakeScreenshot     - best-effort evidence capture (API 30+); failures never
                          fail the run.

  isAccessibilityTool   - Android 14+ hides views flagged as sensitive (the
                          Clear data / Clear cache buttons on the Storage page)
                          from services that do not declare themselves an
                          accessibility tool. This tool drives the UI for
                          testing, so it declares it; Play Store review would
                          need to be revisited if it is ever published.

  Deliberately NOT declared: flagRequestFilterKeyEvents,
  flagRequestTouchExplorationMode, flagRequestEnhancedWebAccessibility,
  canRequestFingerprintGestures, and any form of key-event filtering.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagReportViewIds|flagIncludeNotImportantViews|flagRetrieveInteractiveWindows"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:isAccessibilityTool="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100"
    android:packageNames="com.codifi.dhanush,com.codifi.rmoney,com.android.settings,com.miui.securitycenter,com.google.android.permissioncontroller,com.android.permissioncontroller,com.android.systemui"
    android:summary="@string/accessibility_service_summary" />
